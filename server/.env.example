# Copy this file to .env on the server and fill in the real values.
# Never commit the real .env file to git.

# Claude API key from console.anthropic.com. Kept server-side only -
# the app and the browser never see this value.
ANTHROPIC_API_KEY=sk-ant-changeme

# Which Claude model answers conversations. See README for options.
ANTHROPIC_MODEL=claude-opus-5

# Port the Node server listens on. Apache reverse-proxies to this port.
PORT=3010

# GitHub repo that publishes the Android APK as a release, used by the
# GET /download redirect. Format: owner/repo
APK_REPO=changeme/helper-app

# Fixed asset name the GitHub Actions workflow uploads on every release.
APK_ASSET_NAME=helper.apk
